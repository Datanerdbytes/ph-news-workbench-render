# CodeRabbit local review: catch the app's findings before a push spends a
# full CI run on them. Advisory when the CLI is missing, signed out, or the
# service is unreachable; blocking only on major/critical findings. The
# required CI checks remain the merge gate. Bypass with `git push --no-verify`.

# Review only branch pushes whose tip is the checked-out commit; tag pushes
# and branches checked out elsewhere have nothing this worktree can review,
# and a branch deletion has nothing to review.
head=$(git rev-parse --verify --quiet HEAD) || head=
pushed=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  case "$remote_ref" in
    refs/heads/main | refs/heads/master) continue ;;
    refs/heads/*) ;;
    *) continue ;;
  esac
  if [ "$local_sha" != "$head" ]; then
    echo "CodeRabbit: skipping $remote_ref — not the checked-out commit."
    continue
  fi
  pushed=1
done

[ "$pushed" = "1" ] || exit 0

if ! command -v coderabbit >/dev/null 2>&1; then
  echo "CodeRabbit CLI not installed — skipping local review (brew install coderabbit)."
  exit 0
fi

if ! coderabbit auth status --agent 2>/dev/null | grep -q '"authenticated":true'; then
  echo "CodeRabbit CLI is not signed in — skipping local review (coderabbit auth login)."
  exit 0
fi

# The PR base: origin/main when it exists, the local main otherwise. The repo's
# .coderabbit.yaml is picked up automatically, so profile and path rules match
# the old PR reviews.
base=main
if git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null 2>&1; then
  base=origin/main
fi

# No base ref to compare against — nothing this worktree can review.
if ! git rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
  echo "CodeRabbit: no $base to review against."
  echo "Fetch one so the hook can review this branch: git fetch origin main."
  exit 0
fi

echo "CodeRabbit: reviewing committed changes against $base…"
status=0
coderabbit review --committed --base "$base" --gate major || status=$?

# The hook blocks only on exit 2: major/critical findings in a completed
# review. A non-zero exit from an incomplete review never blocks a push;
# CI remains the merge gate and a fresh local review still shows findings.
if [ "$status" -eq 2 ]; then
  echo "CodeRabbit flagged major or critical findings — fix them, or skip with: git push --no-verify"
  exit 1
fi
if [ "$status" -ne 0 ]; then
  echo "CodeRabbit review could not finish (exit $status) — pushing anyway; CI still gates the merge."
  echo "If the CLI is signed in and this repeats, upgrade it (--gate needs 0.9.1+): brew upgrade coderabbit."
fi
exit 0
