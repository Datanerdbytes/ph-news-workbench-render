# syntax=docker/dockerfile:1

# Media runner worker image — NOT the web app image. This is the standalone
# HTTP service (media-runner.ts) that owns the sandboxed native-media work
# (yt-dlp resolve, live pump) and is deployed on Fly.io, whose Firecracker
# VMs permit the namespaces that Render refuses. It mirrors the web image's
# toolchain exactly: ffmpeg, the pinned yt-dlp static binary, and the
# bubblewrap/socat/ripgrep trio that lib/live/media-sandbox.ts probes for.
FROM node:22-slim

WORKDIR /app
# HUSKY=0: the prepare script needs a .git dir the container does not have.
ENV NODE_ENV=production \
    PORT=8080 \
    HUSKY=0

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
       bubblewrap socat ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g tsx@4.23.15

ARG YTDLP_VERSION=2026.10.26
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      arm64) YTDLP_ASSET=yt-dlp_linux_aarch64 ;; \
      *) YTDLP_ASSET=yt-dlp_linux ;; \
    esac \
    && curl -fsSL \
      "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/${YTDLP_ASSET}" \
      -o /usr/local/bin/yt-dlp \
    && chmod 0755 /usr/local/bin/yt-dlp \
    && yt-dlp --version

COPY package.json package-lock.json .npmrc ./
# Runtime deps only — the worker imports the neon client, the sandbox
# runtime, and undici; tsx comes from the global install above.
RUN npm ci --omit=dev --no-audit --no-fund

COPY tsconfig.json ./
COPY media-runner.ts ./
COPY lib ./lib

USER 1000:1000
EXPOSE 8080
CMD ["tsx", "media-runner.ts"]
