{
  "name": "ph-news-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEON_LOCAL_NEXT_MODE=development NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" next dev",
    "build": "next build",
    "start": "NEON_LOCAL_NEXT_MODE=production NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "NEON_LOCAL_NEXT_MODE=development NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretest:e2e:local": "NEON_LOCAL_NEXT_MODE=development NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" node scripts/require-local-db.mjs",
    "test:e2e:local": "NEON_LOCAL_NEXT_MODE=development NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" playwright test",
    "worker": "NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" node --env-file=.env.local download-worker.ts",
    "worker:avatar": "NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" tsx --env-file=.env.local avatar-worker.ts",
    "worker:install": "bash scripts/install-download-worker.sh",
    "media-runner": "NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" tsx --env-file=.env.local media-runner.ts",
    "scheduler:sweep": "NODE_OPTIONS=\"--import ./scripts/neon-local.mjs\" node --env-file=.env.local scripts/scheduler-sweep.mjs",
    "scheduler:install": "bash scripts/install-scheduler.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.83",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@base-ui/react": "^1.9.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/hub": "^1.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.15",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "hls.js": "^1.7.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/busboy": "^1.5.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vercel/cli-config": "^0.4.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "es5-ext": false,
    "fsevents@2.3.3": true
  }
}
